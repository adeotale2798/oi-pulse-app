# Backend environment (never commit real secrets)

MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=oi_pulse

ADMIN_USERNAME=Adeotale
ADMIN_PASSWORD=change-me

# Local only: passwordless admin for dashboard/render testing.
# Requires APP_ENV=development and loopback-only requests; never enable in staging or production.
# APP_ENV=development
# LOCAL_DEV_ADMIN_BYPASS=true
# Local subscription testing is available only when APP_ENV=development and
# requests use localhost/loopback. Keep the real credentials in backend/.env.
# LOCAL_DEV_MEMBER_USERS='[{"email":"normal@example.test","password":"change-me","plan":"normal"},{"email":"premium@example.test","password":"change-me","plan":"premium"},{"email":"pro@example.test","password":"change-me","plan":"pro"}]'

# CREDENTIALS_FERNET_KEY=
# KITE_API_KEY=
# KITE_ACCESS_TOKEN=

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Optional: Admin → Admin configuration vaults the bot token (Fernet) in settings.telegram_prefs.

# OPENAI_API_KEY=
# DESK_GUIDE_MODEL=gpt-4o-mini
# Optional: Desk AI keys can also be set in Admin → Desk AI keys (vaulted).
# TWELVE_DATA_API_KEY=
# Optional: Admin → ADRs vaults the Twelve Data key (Fernet). Never sent to the browser.

CORS_ORIGINS=http://localhost:3000,https://striklenz.com,https://www.striklenz.com
